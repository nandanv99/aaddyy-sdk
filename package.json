{
  "name": "aaddyy",
  "version": "1.0.3",
  "description": "Official SDK for AADDYY \u2014 50+ AI tools via one npm package: typed methods for common tools, and tool()/toolV2() for any tool in the live catalog. Image generation, article writing, video creation, math solving, SEO analysis, and more.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "test": "npm run build && tsc -p test/tsconfig.json && node --test test/*.test.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "dev": "npx tsx src/index.ts"
  },
  "keywords": [
    "ai",
    "ai-tools",
    "aaddyy",
    "image-generation",
    "article-writer",
    "video-generation",
    "math-solver",
    "seo",
    "logo-generator",
    "sdk",
    "api"
  ],
  "author": "AADDYY <hello@aaddyy.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adivyas99/aaddyy-sdk.git"
  },
  "homepage": "https://www.aaddyy.com",
  "bugs": {
    "url": "https://github.com/adivyas99/aaddyy-sdk/issues"
  }
}
